    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug current TypeScript file",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "node",
            "program": "${file}",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "sourceMaps": true,
            "console": "integratedTerminal"
        }
    ]
}